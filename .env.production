# ===========================================
# PRODUCTION ENVIRONMENT - FRONTEND
# ===========================================
# Set in Vercel Dashboard > Project > Settings > Environment Variables
# Replace with actual values after backend deployment
# ===========================================

# Backend API URL (REQUIRED)
# Replace with your actual backend URL from Vercel after backend deployment
VITE_API_URL=https://your-backend-app.vercel.app/api

# Firebase Configuration (if using Firebase Auth in frontend)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Maps API (if using maps)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay (if using payment gateway in frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
